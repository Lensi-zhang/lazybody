<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    app:iconSpaceReserved="false">

    <PreferenceCategory
        app:title="@string/setting_group_move"
        app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            app:key="setting_joystick_state"
            app:title="@string/setting_joystick_state"
            app:defaultValue="false"
            app:iconSpaceReserved="false"/>
        <ListPreference
            app:key="setting_joystick_type"
            app:title="@string/setting_joystick_type"
            app:entries="@array/array_joystick_type"
            app:entryValues="@array/array_joystick_type_values"
            app:dialogTitle="@string/setting_joystick_type"
            app:defaultValue="0"
            app:iconSpaceReserved="false">
        </ListPreference>

        <EditTextPreference
            app:key="setting_walk"
            app:title="@string/setting_walk"
            app:defaultValue="@string/setting_walk_default"
            app:summary="@string/setting_walk_default"
            app:iconSpaceReserved="false"/>

        <EditTextPreference
            app:key="setting_run"
            app:title="@string/setting_run"
            app:defaultValue="@string/setting_run_default"
            app:summary="@string/setting_run_default"
            app:iconSpaceReserved="false"/>

        <EditTextPreference
            app:key="setting_bike"
            app:title="@string/setting_bike"
            app:defaultValue="@string/setting_bike_default"
            app:summary="@string/setting_bike_default"
            app:iconSpaceReserved="false"/>

        <EditTextPreference
            app:key="setting_altitude"
            app:title="@string/setting_altitude"
            app:defaultValue="@string/setting_altitude_default"
            app:summary="@string/setting_altitude_default"
            app:iconSpaceReserved="false"/>

    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/setting_group_location_offset"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            app:key="setting_random_offset"
            app:title="@string/setting_random_offset"
            app:summary="@string/setting_random_offset_summary"
            app:defaultValue="false"
            app:iconSpaceReserved="false"/>
        <EditTextPreference
            app:key="setting_lat_max_offset"
            app:title="@string/setting_lat_max_offset"
            app:defaultValue="@string/setting_random_offset_default"
            app:summary="@string/setting_random_offset_default"
            app:iconSpaceReserved="false"/>
        <EditTextPreference
            app:key="setting_lon_max_offset"
            app:title="@string/setting_lon_max_offset"
            app:defaultValue="@string/setting_random_offset_default"
            app:summary="@string/setting_random_offset_default"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/setting_group_environment"
        app:iconSpaceReserved="false">
        <ListPreference
            app:key="setting_wifi_mode"
            app:title="@string/setting_wifi_mode"
            app:entries="@array/array_environment_mode"
            app:entryValues="@array/array_environment_mode_values"
            app:defaultValue="PASSTHROUGH"
            app:iconSpaceReserved="false" />
        <EditTextPreference
            app:key="setting_wifi_ssid"
            app:title="@string/setting_wifi_ssid"
            app:defaultValue="LazyBody_WiFi"
            app:iconSpaceReserved="false" />
        <EditTextPreference
            app:key="setting_wifi_bssid"
            app:title="@string/setting_wifi_bssid"
            app:defaultValue="02:00:00:00:00:01"
            app:iconSpaceReserved="false" />
        <EditTextPreference
            app:key="setting_wifi_level"
            app:title="@string/setting_wifi_level"
            app:defaultValue="-50"
            app:iconSpaceReserved="false" />
        <ListPreference
            app:key="setting_cell_mode"
            app:title="@string/setting_cell_mode"
            app:entries="@array/array_environment_mode"
            app:entryValues="@array/array_environment_mode_values"
            app:defaultValue="PASSTHROUGH"
            app:iconSpaceReserved="false" />
        <ListPreference
            app:key="setting_cell_rat"
            app:title="@string/setting_cell_rat"
            app:entries="@array/array_cell_rat"
            app:entryValues="@array/array_cell_rat"
            app:defaultValue="LTE"
            app:iconSpaceReserved="false" />
        <EditTextPreference
            app:key="setting_cell_mcc"
            app:title="@string/setting_cell_mcc"
            app:defaultValue="460"
            app:iconSpaceReserved="false" />
        <EditTextPreference
            app:key="setting_cell_mnc"
            app:title="@string/setting_cell_mnc"
            app:defaultValue="1"
            app:iconSpaceReserved="false" />
        <EditTextPreference
            app:key="setting_cell_tac"
            app:title="@string/setting_cell_tac"
            app:defaultValue="1"
            app:iconSpaceReserved="false" />
        <EditTextPreference
            app:key="setting_cell_cid"
            app:title="@string/setting_cell_cid"
            app:defaultValue="1"
            app:iconSpaceReserved="false" />
        <EditTextPreference
            app:key="setting_cell_level"
            app:title="@string/setting_cell_level"
            app:defaultValue="-80"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/setting_group_log"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            app:key="setting_log_off"
            app:title="@string/setting_log_off"
            app:defaultValue="false"
            app:iconSpaceReserved="false"/>
        <EditTextPreference
            app:key="setting_history_expiration"
            app:title="@string/setting_history_expiration"
            app:defaultValue="@string/history_expiration"
            app:summary="@string/history_expiration"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/setting_group_about"
        app:iconSpaceReserved="false">

        <Preference
            app:key="setting_version"
            app:title="@string/setting_version"
            app:iconSpaceReserved="false"/>

        <Preference
            app:key="setting_author"
            app:title="@string/setting_author"
            app:defaultValue="@string/app_author"
            app:summary="@string/app_author"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>
</PreferenceScreen>